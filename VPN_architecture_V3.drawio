  <diagram name="3 · Provisioning job lifecycle" id="mfGosjaIdVGchA5L9evO">
    <mxGraphModel grid="0" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2100" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t3" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=22;" value="&lt;b style=&quot;font-size:22px;&quot;&gt;Provisioning a gateway — the receipt model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#6B7A8D;&quot;&gt;Nothing that touches Azure runs inside an HTTP request. The API writes a row, drops a message and returns.&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="1300" x="60" y="24" as="geometry" />
        </mxCell>
        <mxCell id="lane" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="190" width="1980" x="60" y="130" as="geometry" />
        </mxCell>
        <mxCell id="p1" parent="1" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;fontColor=#2B3A4A;image=img/lib/azure2/identity/Users.svg;" value="&lt;b&gt;1 · Operator submits&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#6B7A8D;&quot;&gt;region · size · zone · OS&lt;br&gt;availability and cost checks&lt;br&gt;are advisory, never gate&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="60" x="130" y="165" as="geometry" />
        </mxCell>
        <mxCell id="p2" parent="1" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;fontColor=#2B3A4A;image=data:image/svg+xml,;" value="&lt;b&gt;2 · POST /servers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#6B7A8D;&quot;&gt;allocate subnet, generate keys,&lt;br&gt;insert rows, enqueue&lt;br&gt;&lt;b&gt;returns 202 + job_id&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="60" x="500" y="165" as="geometry" />
        </mxCell>
        <mxCell id="p3" parent="1" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;fontColor=#2B3A4A;image=img/lib/azure2/general/Storage_Queue.svg;" value="&lt;b&gt;3 · Worker dequeues&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#6B7A8D;&quot;&gt;visibility timeout, so a crash&lt;br&gt;returns the message&lt;br&gt;rather than losing it&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="60" x="870" y="165" as="geometry" />
        </mxCell>
        <mxCell id="p4" parent="1" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;fontColor=#2B3A4A;image=img/lib/azure2/general/All_Resources.svg;" value="&lt;b&gt;4 · terraform apply&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#6B7A8D;&quot;&gt;state in tfstate-gateways&lt;br&gt;ARM_USE_MSI — no stored&lt;br&gt;service principal&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="60" x="1240" y="165" as="geometry" />
        </mxCell>
        <mxCell id="p5" parent="1" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;fontColor=#2B3A4A;image=img/lib/azure2/general/Toolbox.svg;" value="&lt;b&gt;5 · Ansible over SSH&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#6B7A8D;&quot;&gt;key read from Key Vault&lt;br&gt;site.yml — wireguard and&lt;br&gt;the three agents&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="60" x="1610" y="165" as="geometry" />
        </mxCell>
        <mxCell id="p6" parent="1" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;fontColor=#2B3A4A;image=img/lib/azure2/compute/Virtual_Machine.svg;" value="&lt;b&gt;6 · Gateway live&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#6B7A8D;&quot;&gt;IP and keys written back,&lt;br&gt;Prometheus targets rewritten&lt;br&gt;job marked &lt;b&gt;Completed&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="60" x="1930" y="165" as="geometry" />
        </mxCell>
        <mxCell id="pollBox" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#C5D9F1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=12;fontSize=11;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Meanwhile, the console polls&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5A6772;&quot;&gt;GET /api/v1/jobs/{job_id}&lt;br&gt;GET /api/v1/jobs/{job_id}/events&lt;br&gt;&lt;br&gt;Named stages, an event log and a measured ETA, so a&lt;br&gt;five-minute provision is legible rather than a spinner.&lt;br&gt;Polling is bounded and backs off when the tab is hidden.&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="520" x="60" y="420" as="geometry" />
        </mxCell>
        <mxCell id="failBox" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#F0C6C2;verticalAlign=top;align=left;spacingLeft=16;spacingTop=12;fontSize=11;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Failure path&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5A6772;&quot;&gt;A handler that raises leaves the message on the queue; it&lt;br&gt;reappears after the visibility timeout and is retried. After N&lt;br&gt;attempts it moves to &lt;b&gt;vpn-tasks-poison&lt;/b&gt; and the job is marked&lt;br&gt;&lt;b&gt;Failed&lt;/b&gt; with the captured stderr.&lt;br&gt;&lt;br&gt;POST /jobs/{id}/retry re-queues it; scripts/requeue.py drains&lt;br&gt;poison in bulk. Terraform state is the source of truth, so a&lt;br&gt;half-built gateway is reconciled on retry, not duplicated.&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="560" x="640" y="420" as="geometry" />
        </mxCell>
        <mxCell id="otherBox" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=none;verticalAlign=top;align=left;spacingLeft=16;spacingTop=12;fontSize=11;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;The same pipeline carries every other job type&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5A6772;&quot;&gt;&lt;b&gt;peers&lt;/b&gt;  POST /tunnels adds a WireGuard peer (add_peer.yml); DELETE&lt;br&gt;removes it. Client config comes from GET /tunnels/{id}/config.&lt;br&gt;&lt;b&gt;dns&lt;/b&gt;  allow and deny lists pushed to every gateway (sync_dns_rules.yml).&lt;br&gt;&lt;b&gt;users&lt;/b&gt;  user lifecycle that has to reach the gateways.&lt;br&gt;&lt;b&gt;destroy&lt;/b&gt;  DELETE /servers/{id} runs terraform destroy and drops the&lt;br&gt;gateway from the Prometheus target files.&lt;/font&gt;" vertex="1">
